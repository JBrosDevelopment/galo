let l1 list = list init(int, 10)
println(l1)
l1 = list append(l1, 99)
println(l1)
l1 = list append(l1, 98)
println(l1)
l1 = list append(l1, 97)
println(l1)
l1 = list remove(l1, 1)
println(l1)
l1 = list set(l1, 0, 55)
println(l1)
l1 = list insert(l1, 1, 125)
println(l1)
l1 = list clear(l1)
println(l1)
l1 = list(10, "abc", 789.0, true)
println(l1)

