#!galo interpret project/main.galo --emit-validator --emit-ast -- 1 5 9 3 -5 4 -99 123 
#!include lib.galo

fun main(args list) void
    let i int = 0
    let x int = 0
    while (list length(args) > i)
        let s string = list get(args, i)
        let v int = cast(int, s)
        x = add(x, v)
        i = increment(i)
    end
    println(x)
end


