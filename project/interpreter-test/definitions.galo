const TYPE_OKAY = 0
const TYPE_GOOD = 1
const TYPE_GREAT = 2
const TYPE_AMAZING = 3

struct Data
    type byte
    value string
end

fun Data init(type byte, value string) Data
    let d Data
    d type = type
    d value = value
    return d
end

const RUNTIME_INVALID_COMMAND = 0
const RUNTIME_ADD = 1
const RUNTIME_REMOVE = 2
const RUNTIME_CLEAR = 3
const RUNTIME_FILTER = 4
const RUNTIME_PRINT = 5
const RUNTIME_EXIT = 6